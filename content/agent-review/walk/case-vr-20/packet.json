  {
   "itemId": "gen-vr-10-word-connections-01",
   "stem": {
    "pairA": [
     "winter",
     "cold"
    ],
    "prompt": "Find the connection in the first pair, then complete the second.",
    "stemWord": "summer"
   },
   "key": "warm",
   "options": [
    "warm",
    "holiday",
    "August"
   ],
   "walkScript": "Look at winter and cold. Winter is a season; cold is how it feels. Summer is a season too, so warm fits. Holiday and August share summer, not the feeling."
  },
  {
   "itemId": "gen-vr-10-word-connections-02",
   "stem": {
    "pairA": [
     "minute",
     "hour"
    ],
    "prompt": "Find the connection in the first pair, then complete the second.",
    "stemWord": "hour"
   },
   "key": "day",
   "options": [
    "day",
    "clock",
    "week"
   ],
   "walkScript": "Start with minute and hour. Many minutes make one hour, a bigger unit. So hours make one day, bigger again. Clock and week miss that step in size."
  },
  {
   "itemId": "gen-vr-10-word-connections-03",
   "stem": {
    "pairA": [
     "leaf",
     "tree"
    ],
    "prompt": "Find the connection in the first pair, then complete the second.",
    "stemWord": "petal"
   },
   "key": "flower",
   "options": [
    "flower",
    "garden",
    "stem"
   ],
   "walkScript": "Begin with leaf and tree. A leaf is part of the tree. In the same way, a petal is part of a flower. Garden and stem are not the whole flower."
  },
  {
   "itemId": "gen-vr-10-word-connections-04",
   "stem": {
    "pairA": [
     "captain",
     "ship"
    ],
    "prompt": "Find the connection in the first pair, then complete the second.",
    "stemWord": "pilot"
   },
   "key": "plane",
   "options": [
    "plane",
    "airport",
    "wing"
   ],
   "walkScript": "Read captain and ship first. A captain steers the ship he leads. So a pilot steers a plane, and plane fits. Airport and wing sit by planes, steering nothing."
  },
  {
   "itemId": "gen-vr-10-word-connections-05",
   "stem": {
    "pairA": [
     "bee",
     "honey"
    ],
    "prompt": "Find the connection in the first pair, then complete the second.",
    "stemWord": "cow"
   },
   "key": "milk",
   "options": [
    "milk",
    "farm",
    "grass"
   ],
   "walkScript": "Take the pair bee and honey. A bee gives honey to eat. Milk is what a cow gives. Farm and grass go with cows, not food."
  },
  {
   "itemId": "gen-vr-10-word-connections-06",
   "stem": {
    "pairA": [
     "sheep",
     "lamb"
    ],
    "prompt": "Find the connection in the first pair, then complete the second.",
    "stemWord": "horse"
   },
   "key": "foal",
   "options": [
    "foal",
    "stable",
    "hay"
   ],
   "walkScript": "First read sheep and lamb. A lamb is the baby of a sheep. Likewise a foal is the baby of a horse. Stable and hay go with horses, not young."
  }
 ],
