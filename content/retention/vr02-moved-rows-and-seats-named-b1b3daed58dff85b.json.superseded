{
 "kind": "VR-02-THE-MOVED-ROWS-AS-CONTENT-AND-THE-SEATS-NAMED",
 "TO": "the authoring store; Annie and David by relay",
 "date": "2026-09-05",
 "THE_BOUND_POPULATION": {
  "file": "vr-arc-census-and-population-bb6be0d3f2fed905.json",
  "sha256": "bb6be0d3f2fed905399329e5c18d7a25a707d6d909150eb2ee45e1227c2e8fab",
  "verifiedBeforeUse": true,
  "andWHEREITISNOW": "archived out of the lane on 2026-09-05 with 840 other August files; the archive is at ~/Downloads/11+/archive/from-cluecrew/2026-08/ and every digest was re-verified on the move."
 },
 "ONE_THE_SEVENTEEN_AS_CONTENT": {
  "whyCONTENTANDNOTDIGESTS": "your ten refusals are bound to superseded bytes. A digest says a row CHANGED; it does not say what the row now READS, so re-binding would tell you your work describes something else without telling you what to author instead. That is why vr-19's twenty-five were re-authored rather than re-bound.",
  "count": 17,
  "derivedFrom": {
   "parent": "every vr-02 row in the crossed population bb6be0d3",
   "parentSize": 25,
   "rule": "the row's content digest differs from the one bb6be0d3 recorded, ignoring serialisation",
   "kept": 17,
   "excluded": 8,
   "andWHATAREADERCANNOTSEEFROMTHEROWS": "the moved rows is a SUBSET of every vr-02 row in the crossed population bb6be0d3, not a population. 8 of 25 were excluded by: the row's content digest differs from the one bb6be0d3 recorded, ignoring serialisation. A zero or a small count from this list is a fact about the narrowing as much as about the world, and nothing in the rows themselves says so."
  },
  "THE_DIGEST_SUBJECT": {
   "subjectKeys": [
    "stem",
    "options[].value",
    "options[].isKey",
    "solution"
   ],
   "spec": "R729 over {stem, options:[{value,isKey}], solution} — the spec batch one's rowSha256 already uses, so these numbers compare directly with the one every execution carries",
   "andWHYTHEKEYSANDNOTONLYTHESPEC": "the keys are the subject; the spec says how they are serialised. A consumer that reads the keys projects exactly what was hashed. A consumer that reads only the prose rebuilds the projection from a sentence, and a field on the row that the sentence does not name will be included by anyone doing the obvious thing (R985).",
   "everyOtherKeyOnTheRowIsEXCLUDED": "rows in this artefact carry more than the subject names — enrichment such as tag, tagIsActiveInTheLibrary and execution. They are NOT part of any digest here."
  },
  "andWHATEACHROWCARRIES": "the stem as the child meets it, the FULL three-part set — the key, its siblings, and their tags with the wording a child would receive (R573) — the current rowSha256, the digest it had in bb6be0d3, and what the row used to read.",
  "ROWS": [
