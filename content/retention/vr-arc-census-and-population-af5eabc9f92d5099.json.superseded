   "questionType": "vr-10-word-connections",
   "sizeInThisSection": 6,
   "rows": [
    {
     "itemId": "gen-vr-10-word-connections-01",
     "slot": "01",
     "tier": 2,
     "stem": {
      "pairA": [
       "winter",
       "cold"
      ],
      "prompt": "Find the connection in the first pair, then complete the second.",
      "stemWord": "summer"
     },
     "options": [
      {
       "value": "warm",
       "isKey": true,
       "tag": null,
       "tagIsActiveInTheLibrary": null,
       "execution": null
      },
      {
       "value": "holiday",
       "isKey": false,
       "tag": "vr03-same-topic",
       "tagIsActiveInTheLibrary": true,
       "execution": null
      },
      {
       "value": "August",
       "isKey": false,
       "tag": "vr03-same-topic",
       "tagIsActiveInTheLibrary": true,
       "execution": null
      }
     ],
     "explanation": {
      "walkScript": "Look at winter and cold. Winter is a season; cold is how it feels. Summer is a season too, so warm fits. Holiday and August share summer, not the feeling.",
