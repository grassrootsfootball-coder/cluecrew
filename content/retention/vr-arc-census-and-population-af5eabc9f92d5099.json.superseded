 "TWO_THE_SECTIONED_POPULATION": {
  "SECTIONED_BY": "CASE — because the slot census came back NOT PARALLEL. Sectioning by slot was the version that collapses the calendar and this corpus does not support it.",
  "sectionSize": 6,
  "andTHEREMAINDER": "sections never cross a case boundary, so each 25-row case yields 6+6+6+6+1. The trailing single-row section is real and is not padded — merging it into a neighbour would put two cases in one sitting.",
  "sections": 55,
  "rowsAcrossSections": 275,
  "contiguousByCase": true
 },
 "THREE_THE_WHOLENESS_CENSUS": {
  "underTheCurrentBar": "per row: tags attested, executions present, walkScript where walk mode serves",
  "rows": 275,
  "distractorsTotal": 650,
  "tagged": 641,
  "tagsAttested": 641,
  "untaggedDistractors": 9,
  "tagsNamingNoActiveEntry": 0,
  "executionsPresent": 0,
  "rowsWithWalkScript": 25,
  "casesWhereWalkServesARealAsset": 0,
  "rowsWithAnyExplanation": 25,
  "THE_BINDING_ABSENCE": "executions present on 0 of 650 distractors. Zero, as reported, and it is not the reviewer's work.",
  "andTHEWALKSCRIPTLINE": "walkScript present on 25 rows — and walk mode serves a REAL asset in 0 of 11 cases. Every VR case declares walk as a faded-example whose assetRef is under placeholder/. **So \"walkScript where walk mode serves\" currently has an empty denominator**: no case serves a real walk asset, so no row is yet obliged to carry a script. That is a declaration about the mode, not an absence in the rows.",
  "soTHEREADINGANDTHEAUTHORINGCANRUNINPARALLEL": "the reading needs stems, options and keys, which are whole. The authoring needs executions, which are absent everywhere and block nothing she does."
 },
