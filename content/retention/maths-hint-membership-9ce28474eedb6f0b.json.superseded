   "id": "maths-45-diagonals-as-symmetry",
   "status": "ACTIVE",
   "approvedBy": "human:staff-reviewer@cluecrew.test",
   "wording": "If you folded a rectangle along its diagonal line, would the corners match up perfectly?",
