   },
   "overSixteenWordSentences": []
  },
  {
   "kind": "library",
   "id": "maths-37-metric-prefix-confusion",
   "status": "ACTIVE",
   "approvedBy": "human:staff-reviewer@cluecrew.test",
   "wording": "\"Kilo\" always means one thousand. There are 1,000 grams in a kilogram.",
   "wordingSha256": "40504c0caaeddb345836ea5980a5aa7c747c51fb93eb9c11be4d7c50e9507371",
   "servesToday": false,
   "reach": {
