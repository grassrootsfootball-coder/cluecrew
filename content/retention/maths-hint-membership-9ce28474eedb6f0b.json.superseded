   },
   "overSixteenWordSentences": []
  },
  {
   "kind": "library",
   "id": "maths-31-dropping-the-zero-in-money",
   "status": "ACTIVE",
   "approvedBy": "human:staff-reviewer@cluecrew.test",
   "wording": "Money always needs two decimal places to show the pennies. Add a placeholder zero!",
   "wordingSha256": "d088e82fe2ec9a28b88ab957bfe865bb8e828cef9e16a1d768f58bb9640dc892",
   "servesToday": false,
