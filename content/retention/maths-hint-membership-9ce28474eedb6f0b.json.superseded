   "id": "maths-40-area-dictates-perimeter",
   "status": "ACTIVE",
   "approvedBy": "human:staff-reviewer@cluecrew.test",
   "wording": "Try drawing two different shapes with an area of 12 squares. Now count the outside edges of both — are they the same?",
   "wordingSha256": "71aa60cf8fbeb88a2a9230b027197a23cfe21b345e6c9a6e695ddd38f07efb96",
