  },
  {
   "kind": "library",
   "id": "maths-43-line-length-dictates-angle",
   "status": "ACTIVE",
   "approvedBy": "human:staff-reviewer@cluecrew.test",
   "wording": "An angle measures the turn between two lines. It does not measure how long they are.",
   "wordingSha256": "ef884f83c59683b1ed5b66a467607c8f89b9c32f09f6ab95f7ab00bab519b5b6",
   "servesToday": false,
