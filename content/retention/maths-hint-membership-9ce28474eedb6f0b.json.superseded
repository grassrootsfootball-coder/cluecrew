  {
   "kind": "library",
   "id": "maths-51-additive-scaling",
   "status": "ACTIVE",
   "approvedBy": "human:staff-reviewer@cluecrew.test",
   "wording": "Recipes scale up by multiplication. If you double the eggs, you need to double the cakes too!",
   "wordingSha256": "7e5e186203e6a781bae14f698012ad2e1e4238526f594e3c2ab587496bef303b",
