   "id": "maths-42-square-rectangle-exclusivity",
   "status": "ACTIVE",
   "approvedBy": "human:staff-reviewer@cluecrew.test",
   "wording": "A rectangle has four right angles and opposite equal sides. Does a square have those? Yes! A square is just a very special rectangle.",
   "wordingSha256": "92ba963c90f49775a2306c217d21d111a9e4db747fbe9e82b07099d059601f18",
