    "caseCount": 0
   },
   "overSixteenWordSentences": []
  },
  {
   "kind": "library",
   "id": "maths-30-fractions-of-different-wholes",
   "status": "ACTIVE",
   "approvedBy": "human:staff-reviewer@cluecrew.test",
   "wording": "Fractions show proportions, not exact sizes. A quarter of a small pizza differs from a massive one!",
   "wordingSha256": "fb17a1a49810b8e91e99460f917f356cec43ec69fecbdeb47576c2753be98bc9",
   "servesToday": false,
   "reach": {
