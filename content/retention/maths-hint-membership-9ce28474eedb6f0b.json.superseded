   },
   "overSixteenWordSentences": []
  },
  {
   "kind": "library",
   "id": "maths-28-fractions-as-two-separate-numbers",
   "status": "ACTIVE",
   "approvedBy": "human:staff-reviewer@cluecrew.test",
   "wording": "A fraction is a single number. The line in the middle just means \"divide\".",
   "wordingSha256": "91d9f9a85e59aa77d51279737293f24554c7c0d314419adb6ad9ada653b818a1",
   "servesToday": false,
