   },
   "overSixteenWordSentences": []
  },
  {
   "kind": "library",
   "id": "maths-29-comparing-without-common-denominators",
   "status": "ACTIVE",
   "approvedBy": "human:staff-reviewer@cluecrew.test",
   "wording": "You cannot compare them fairly until they are speaking the same language. Make the bottom numbers match first.",
   "wordingSha256": "8f0779f091a2bbbf52fb0cfd7cf145d048d46833d9a06b71d4c8f2e748a5d93e",
   "servesToday": false,
   "reach": {
    "liveItems": [],
