   },
   "overSixteenWordSentences": []
  },
  {
   "kind": "library",
   "id": "maths-35-assuming-scale-ticks-are-1",
   "status": "ACTIVE",
   "approvedBy": "human:staff-reviewer@cluecrew.test",
   "wording": "Look at the numbers provided. How much space is between them, and how many jumps are there? Divide the space by the jumps!",
   "wordingSha256": "1e4f313a4d7f9c388a2a8fb6000fe57602da1b8beed26ae93782b0e80a5381f8",
   "servesToday": false,
