  {
   "kind": "library",
   "id": "maths-33-12-24-hour-confusion",
   "status": "ACTIVE",
   "approvedBy": "human:staff-reviewer@cluecrew.test",
   "wording": "In the 24-hour clock, the day starts at exactly 00:00 (midnight).",
   "wordingSha256": "b87b1c9876592669e6b3d5d4b1a6ff84fd54e07c13bb827dbf394d365ad2fbab",
