  {
   "kind": "library",
   "id": "maths-34-starting-measurement-at-1",
   "status": "ACTIVE",
   "approvedBy": "human:staff-reviewer@cluecrew.test",
   "wording": "Line up the edge of your object with the zero line. Do not start at one.",
   "wordingSha256": "27b221a2f58b3b4f1e130469ff3b0b40e8c679665722c34768d8502b6a52a884",
   "servesToday": false,
