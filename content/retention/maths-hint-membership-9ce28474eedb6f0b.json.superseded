   "status": "ACTIVE",
   "approvedBy": "human:staff-reviewer@cluecrew.test",
   "wording": "Do not just guess where the line sits. Work out exactly what one little square is worth on the axis first.",
   "wordingSha256": "6eea5e37aa107fe7051e9be859a42c263f79cb6723221d7d8ee695663a6852ad",
