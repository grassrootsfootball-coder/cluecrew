   "id": "maths-49-universal-symmetry",
   "status": "ACTIVE",
   "approvedBy": "human:staff-reviewer@cluecrew.test",
   "wording": "Only isosceles and equilateral triangles have lines of symmetry. A scalene triangle has none at all!",
   "wordingSha256": "23fd474059df4259ae6d369266a019b285ed3d830ef029a5c68a5eef40234295",
