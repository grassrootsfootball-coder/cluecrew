    "liveItemCount": 0,
    "caseCount": 0
   },
   "overSixteenWordSentences": []
  },
  {
   "kind": "library",
   "id": "maths-39-perimeter-vs-area-multiplying",
   "status": "ACTIVE",
   "approvedBy": "human:staff-reviewer@cluecrew.test",
   "wording": "To find the perimeter, imagine walking around the very edge. Add up the whole journey!",
   "wordingSha256": "1002d19eac575ab7fe0133087351343196f969cdb8602fc7c0f55e701c7e08da",
   "servesToday": false,
