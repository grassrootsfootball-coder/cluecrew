   "id": "maths-50-faces-vs-edges",
   "status": "ACTIVE",
   "approvedBy": "human:staff-reviewer@cluecrew.test",
   "wording": "A face is the flat part you can put a sticker on. An edge is the sharp part you could run your finger along.",
   "wordingSha256": "70b318ef311665156c923bfa6fc508d9c35f545a3bd30ac3af084d009ff14718",
