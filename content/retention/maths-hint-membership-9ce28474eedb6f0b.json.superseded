   "status": "ACTIVE",
   "approvedBy": "human:staff-reviewer@cluecrew.test",
   "wording": "A fraction is part of the whole. First, add the ratio parts to find the total.",
   "wordingSha256": "ecbed00089be9f85e48a815deba7cea6a517a2d539d4ba7195d2c91e46230fe9",
