   },
   "overSixteenWordSentences": []
  },
  {
   "kind": "library",
   "id": "maths-38-perimeter-vs-area-adding",
   "status": "ACTIVE",
   "approvedBy": "human:staff-reviewer@cluecrew.test",
   "wording": "Perimeter is the fence around the outside (add the sides). Area is the grass inside (multiply the length by the width).",
   "wordingSha256": "5bf57e5a0e4d06d840286c6663c8b5c009e6a4a4fc13a868134327f0079b30b0",
   "servesToday": false,
   "reach": {
    "liveItems": [],
