  },
  {
   "kind": "library",
   "id": "maths-27-improper-fractions-are-wrong",
   "status": "ACTIVE",
   "approvedBy": "human:staff-reviewer@cluecrew.test",
   "wording": "Top-heavy fractions are perfectly fine for working out the maths. You only need to turn them back at the very end.",
   "wordingSha256": "d15ab821f55ecf238fad78373c70143d26b0d747d638d9aaaef29228e239304e",
