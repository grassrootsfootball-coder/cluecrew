   },
   "overSixteenWordSentences": []
  },
  {
   "kind": "library",
   "id": "maths-32-base-100-time",
   "status": "ACTIVE",
   "approvedBy": "human:staff-reviewer@cluecrew.test",
   "wording": "There are only 60 minutes in an hour. Once you hit 60, you need to roll over into the next hour.",
   "wordingSha256": "0daac798c5bfde729b8a43a96c24366e82df88737a3e6917d3188a756c923c8d",
