   "id": "maths-44-reading-the-wrong-protractor-scale",
   "status": "ACTIVE",
   "approvedBy": "human:staff-reviewer@cluecrew.test",
   "wording": "Look at the angle first. Is it smaller or larger than a perfect right angle (90°)? Use that to choose the right number!",
   "wordingSha256": "4eb28551d6fca2e5603e4aa9ab3eb30934e20cf640a282ffae87d50e6512339c",
