   "status": "ACTIVE",
   "approvedBy": "human:staff-reviewer@cluecrew.test",
   "wording": "Always check the key before you start counting! Sometimes one picture stands for 2, 5, or even 10 things.",
   "wordingSha256": "b0610894fc12248ecb900e79159fe1ffb36d6b1e9d3835bd3e0e2f19d2a49010",
