 "howToCheckThisOnArrival": {
  "subtreeKeys": [
   "NOTICES",
   "WHAT_NEEDS_NO_NOTICE"
  ],
  "subtree": "an object of THIS DOCUMENT'S OWN TOP-LEVEL KEYS, exactly as spelled in subtreeKeys and nowhere renamed: {\"NOTICES\", \"WHAT_NEEDS_NO_NOTICE\"}",
  "spec": "sha256 over json.dumps(subtree, sort_keys=True, separators=(\",\",\":\"), ensure_ascii=False).encode(\"utf-8\") — R729. ensure_ascii defaults to True and gives a different number.",
  "andTheFileDigest": "the staging line and the .sha256 sidecar, over the whole file bytes"
 },
 "DIGESTS": {
  "THE_FILE_DIGEST": "this file's own name and its .sha256 sidecar carry it. It cannot be written here: a file that states its own byte-hash changes the bytes it is stating.",
  "theFileDigestSpec": "sha256 over the whole file bytes. This is what the filename carries after deliver() restamps, what the .sha256 sidecar holds, and what a receiving store should quote back to confirm arrival.",
  "THE_FINDINGS_DIGEST": "c7a8e6c74c18b5d51967c5997be20c77eb4875fba0d356ee01b74426b85ae709",
  "theFindingsDigestSpec": "sha256 over json.dumps(subtree, sort_keys=True, separators=(\",\",\":\"), ensure_ascii=False) where subtree is {\"NOTICES\", \"WHAT_NEEDS_NO_NOTICE\"} — R729. It measures the FINDINGS, not the file, and changes only when a finding changes.",
  "andWHYBOTH": "they never agree and neither is wrong. The file digest identifies the bytes; the findings digest identifies the claim. Quoting one without naming which is how one landing acquires two names (R981)."
 },
 "instrumentProvenance": {
  "emittedBy": "declare-supersessions.ts",
  "carriedFixture": false,
  "MARK": "FROM AN UNFIXTURED INSTRUMENT",
  "meaning": "this emitter carries no fixture, so nothing in this run proves it can find what it claims to find or stay silent on what is clean. Read its figures accordingly (Annie's clause, R726).",
  "remedy": "the emitter earns a carried fixture before its next emission crosses (R725)."
 }
}
