  "subtree": "an object of THIS DOCUMENT'S OWN TOP-LEVEL KEYS, exactly as spelled in subtreeKeys and nowhere renamed: {\"THE_SEATS\", \"THE_CUT_AND_ITS_INSTRUMENT\", \"SEATS_FOUND\"}",
  "spec": "sha256 over json.dumps(subtree, sort_keys=True, separators=(\",\",\":\"), ensure_ascii=False).encode(\"utf-8\") — R729. ensure_ascii defaults to True and gives a different number.",
  "andTheFileDigest": "the staging line and the .sha256 sidecar, over the whole file bytes"
 },
 "DIGESTS": {
  "THE_FILE_DIGEST": "this file's own name and its .sha256 sidecar carry it. It cannot be written here: a file that states its own byte-hash changes the bytes it is stating.",
  "theFileDigestSpec": "sha256 over the whole file bytes. This is what the filename carries after deliver() restamps, what the .sha256 sidecar holds, and what a receiving store should quote back to confirm arrival.",
  "THE_FINDINGS_DIGEST": "6679d55c0d8965e8e72a7333cf67f00d872f46340396dd6f913d439b8c143365",
  "theFindingsDigestSpec": "sha256 over json.dumps(subtree, sort_keys=True, separators=(\",\",\":\"), ensure_ascii=False) where subtree is {\"THE_SEATS\", \"THE_CUT_AND_ITS_INSTRUMENT\", \"SEATS_FOUND\"} — R729. It measures the FINDINGS, not the file, and changes only when a finding changes.",
  "andWHYBOTH": "they never agree and neither is wrong. The file digest identifies the bytes; the findings digest identifies the claim. Quoting one without naming which is how one landing acquires two names (R981)."
 },
