    "childHint": "This answer treats the percentage as a whole number. A percentage is a share out of one hundred.",
    "status": "ACTIVE"
   },
   {
    "id": "maximum-given-for-a-sum",
    "description": "answers a total question with the largest single value instead of adding the values.",
    "childHint": "The biggest number alone is not the total. A total needs every value added.",
    "status": "ACTIVE"
   },
   {
    "id": "ordering-goal-reversed",
