 "theRulesThatAreNotLists": {
  "retention": {
   "rule": "ANY path segment beginning with an underscore is RETENTION (R715). It is a rule, not a list, so a before-image nobody has written yet is covered on the day it appears.",
   "predicate": "isRetentionPath(path)"
  },
  "notationBearingPaths": [
   "stem.target",
   "stem.frame",
   "stem.stemWord",
   "stem.word1",
   "stem.word2",
   "stem.sum",
   "stem.code.P",
   "stem.code.Q",
   "stem.code.R",
   "stem.code.S",
   "stem.series[]",
   "stem.pairA[]",
   "stem.words[]",
   "stem.clues[]",
   "options[].content.value",
   "options[].content.label"
  ],
  "symbolhood": {
   "rule": "a symbol in its own system: one token, no internal whitespace, no sentence punctuation (R719). Notation is exempt ONLY where the path carries symbols AND the string IS one — a capital inside a sentence a child reads can never claim it.",
   "predicate": "isSymbolString(text)"
  },
  "gapMarkers": {
   "rule": "a gap marker is exempt WHEREVER IT SITS, including inside a sentence, because the sentence is where the gap must appear (R722). The exemption is for the MARKER, never the sentence around it.",
   "predicate": "gapMarkerSpans(text)"
  },
  "stimulusWords": {
   "rule": "a stimulus word in a prompt is NOT notation and amends to QUOTED form under her 142nd's precedent (R723). Wired this turn: the vr-12 generator and 25 derived rows now read joins with \"tooth\" rather than TOOTH.",
   "predicate": "capitalRunIsExempt(...) === false"
  }
 },
 "conformanceCases": {
  "why": "run your implementation against these and it either agrees or it does not — a membership that cannot be verified on arrival is prose (the fixture discipline, R721, applied to a crossing).",
  "THE_BOUNDARY_RULE": "A CONFORMANCE SUITE THAT AVOIDS THE BOUNDARY PROVES AGREEMENT ABOUT THE INTERIOR ONLY. The first eleven cases here passed 11 of 11 while the two implementations disagreed on every frame in the corpus, because not one case put a capital run ADJACENT TO A MARKER — the only place they differ. Cases are chosen at the seams a rule creates, never in the middle of what it obviously covers.",
  "cases": [
   {
    "fn": "dispositionFor",
    "args": [
     "stem",
     "text"
    ],
    "expect": "child"
   },
   {
    "fn": "dispositionFor",
    "args": [
     "explanation",
     "note"
    ],
    "expect": "child"
   },
   {
    "fn": "dispositionFor",
    "args": [
     "options[]",
     "attractorQuote"
    ],
    "expect": "quotation"
   },
   {
    "fn": "dispositionFor",
    "args": [
     "stem",
     "_previousText"
    ],
    "expect": "retention"
   },
   {
    "fn": "dispositionFor",
    "args": [
     "stem",
     "somethingNobodyHasRuled"
    ],
    "expect": null
   },
   {
    "fn": "isRetentionPath",
    "args": [
     "explanation._repairAuthority.landedHereOn"
    ],
    "expect": true
   },
   {
    "fn": "isSymbolString",
    "args": [
     "SH___"
    ],
    "expect": true
   },
   {
    "fn": "isSymbolString",
    "args": [
     "He SHOUTED at the dog."
    ],
    "expect": false
   },
   {
    "fn": "gapMarkerSpans",
    "args": [
     "Ade was the ___(2)___ runner."
    ],
    "expect": [
     [
      12,
      21
     ]
    ]
   },
   {
    "fn": "capitalRunIsExempt",
    "args": [
     "stem",
     "sentence",
     "Ade was the ___(2)___ runner.",
     12,
     21
    ],
    "expect": true
   },
   {
    "fn": "capitalRunIsExempt",
    "args": [
     "stem",
     "prompt",
     "Which word joins with AIR to make one new word?",
     22,
     25
    ],
    "expect": false
   },
   {
    "fn": "gapMarkerSpans",
    "args": [
     "The word stops at DE___VE."
    ],
    "expect": [
     [
      18,
      25
     ]
    ]
   },
   {
    "fn": "gapMarkerSpans",
    "args": [
     "See where the word splits: COM___E."
    ],
    "expect": [
     [
      27,
      34
     ]
    ]
   },
   {
    "fn": "gapMarkerSpans",
    "args": [
     "The frame reads SH___."
    ],
    "expect": [
     [
      16,
      21
     ]
    ]
   },
   {
    "fn": "gapMarkerSpans",
    "args": [
     "Look at the frame ___AN."
    ],
    "expect": [
     [
      18,
      23
     ]
    ]
   },
   {
    "fn": "capitalRunIsExempt",
    "args": [
     "explanation",
     "walkScript",
     "The word stops at DE___VE.",
     18,
     20,
     "// DE — letters BEFORE the blank"
    ],
    "expect": true
   },
   {
    "fn": "capitalRunIsExempt",
    "args": [
     "explanation",
     "walkScript",
     "The word stops at DE___VE.",
     23,
     25,
     "// VE — letters AFTER the blank"
    ],
    "expect": true
   },
   {
    "fn": "capitalRunIsExempt",
    "args": [
     "explanation",
     "walkScript",
     "Look at the frame ___AN.",
     21,
     23,
     "// AN — a frame that OPENS with the blank"
    ],
    "expect": true
   },
   {
    "fn": "capitalRunIsExempt",
    "args": [
     "explanation",
     "walkScript",
     "OUT makes SHOUT, and shouting wakes the baby.",
     0,
     3,
     "// THE CONTROL — a capital run with no marker anywhere; both stores must say false, or they agree by exempting everything"
    ],
    "expect": false
   }
  ]
 },
