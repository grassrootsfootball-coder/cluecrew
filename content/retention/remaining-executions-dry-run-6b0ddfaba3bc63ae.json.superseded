  {
   "itemId": "ENG-005-BB-12",
   "optionValue": "He cannot talk to the men at all, so he shows them what he means instead.",
   "file": "eng005draft (4).json",
   "why": "no option on this row resolves to that identity"
  },
  {
   "itemId": "ENG-005-BB-12",
   "optionValue": "He is not frightened at all, but braver than the men on the bridge.",
   "file": "eng005draft (4).json",
   "why": "no option on this row resolves to that identity"
  },
  {
   "itemId": "ENG-005-BB-12",
   "optionValue": "The men explain each thing to him as they go, and he takes it all in.",
   "file": "eng005draft (4).json",
   "why": "no option on this row resolves to that identity"
  },
  {
   "itemId": "ENG-007-LP-06",
   "optionValue": "He has grown careless by the end and forgets what he set out to do.",
   "file": "eng007draft (5).json",
   "why": "no option on this row resolves to that identity"
  },
  {
   "itemId": "ENG-007-LP-08",
   "optionValue": "To show the team still needs more players.",
   "file": "eng007draft (5).json",
   "why": "no option on this row resolves to that identity"
  },
  {
   "itemId": "ENG-007-LP-08",
   "optionValue": "To show that nobody at the school wants to play.",
   "file": "eng007draft (5).json",
   "why": "no option on this row resolves to that identity"
  },
  {
   "itemId": "ENG-007-LP-08",
   "optionValue": "To show that eleven people used eleven different pens.",
   "file": "eng007draft (5).json",
   "why": "no option on this row resolves to that identity"
  },
  {
   "itemId": "ENG-011-CV-12",
   "optionValue": "They never take her seriously, and answer her only politely.",
   "file": "eng011draft (2).json",
   "why": "no option on this row resolves to that identity"
  },
  {
