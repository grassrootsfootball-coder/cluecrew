   },
   {
    "itemId": "ENG-006-TM-09",
    "district": "ENGLISH",
    "optionValue": "Somebody's toes, with a yell.",
    "seatTag": "en-wrong-scope-retrieval",
    "sourceFile": "eng006draft (5).json",
    "sourceDigest": "ff3b82e08cf3c9e9",
    "THE_TEXT_IN_THESE_ROWS": "True of line 48, but that is the hammer falling, not Uncle Podger. In the window, line 43 answers the stem: 'inches beyond what was possible for him to reach'.",
    "itsSha256": "744ec565b2c358abc24ac6f1541d08dbf9133e49c2abcba75c491f4a0eb2f40c",
