   },
   {
    "itemId": "ENG-008-RC-07",
    "district": "ENGLISH",
    "optionValue": "the excitement of finding a forgotten room",
    "seatTag": "en-wrong-scope-retrieval",
    "sourceFile": "eng008draft (2).json",
    "sourceDigest": "8629bccc1ecfc2c0",
    "THE_TEXT_IN_THESE_ROWS": "That happens at line 46, the morning after, and this word is about the night before. In the window, line 48 answers the stem: 'The forgotten room opened out of the kitchen. In'.",
    "itsSha256": "128c927031aeb1bd7b9aa23733eadeff6342b8440bf77af2f9d420fdad32877c",
