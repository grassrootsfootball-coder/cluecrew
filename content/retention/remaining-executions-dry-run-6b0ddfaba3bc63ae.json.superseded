   {
    "itemId": "ENG-010-JE-11",
    "district": "ENGLISH",
    "optionValue": "Jane has met Mr Rochester before, though only once at the hall.",
    "seatTag": "en-negation-dropped",
    "sourceFile": "eng010draft (2).json",
    "sourceDigest": "0e575c5bebd41c73",
    "THE_TEXT_IN_THESE_ROWS": "Line 77 says she has never seen him, and this option loses that.",
    "itsSha256": "bf8c4aafa6d3f0d47a5131e42f6c01bb44a5142aee9e51b3ff8aa090dadf5121",
    "THE_TEXT_IN_THE_CROSSED_ARTEFACT": "Line 72 says she has never seen him, and this option loses that.",
    "itsSha256Crossed": "0a1b3a3faf499bdde1083424dbb39e2e559faff7e8165c032aaa6e4204f42a66"
   },
   {
    "itemId": "ENG-010-JE-11",
    "district": "ENGLISH",
    "optionValue": "He is annoyed to find her out, and says so.",
    "seatTag": "en-emotion-label-approximation",
    "sourceFile": "eng010draft (2).json",
    "sourceDigest": "0e575c5bebd41c73",
    "THE_TEXT_IN_THESE_ROWS": "Line 87's deuce take me is aimed at his own forgetting, not at her being there.",
    "itsSha256": "0211f69b661f92d5f61185bba21f7d17cb7292d167baa5b91de8d12adaebd369",
    "THE_TEXT_IN_THE_CROSSED_ARTEFACT": "Line 82's deuce take me is aimed at his own forgetting, not at her being there.",
    "itsSha256Crossed": "2497cd032acd997c3417c5d45bd833a436352db477e7a169e8dfc7a2f4d169f9"
   },
   {
    "itemId": "ENG-010-JE-11",
    "district": "ENGLISH",
    "optionValue": "Jane is the one who asks, and he is the one who answers.",
    "seatTag": "en-agent-patient-reversal",
    "sourceFile": "eng010draft (2).json",
    "sourceDigest": "0e575c5bebd41c73",
    "THE_TEXT_IN_THESE_ROWS": "Line 74 runs the other way: he asks, and she answers at line 75.",
    "itsSha256": "f49a3d7496a0c2a25988ece40b0791e5c1a25a3e47b6ed8b1ada952f4329d510",
    "THE_TEXT_IN_THE_CROSSED_ARTEFACT": "Line 69 runs the other way: he asks, and she answers at line 70.",
    "itsSha256Crossed": "eae1e4a615fa5f0fb59384ae43c32f820c869e21818007ecc94c8cb81875b6cc"
   },
   {
    "itemId": "ENG-011-CV-09",
    "district": "ENGLISH",
    "optionValue": "She doubts the story rather than the stain itself.",
    "seatTag": "en-wrong-scope-retrieval",
    "sourceFile": "eng011draft (2).json",
    "sourceDigest": "7729a6ab4d5eb41e",
    "THE_TEXT_IN_THESE_ROWS": "True at line 55, where the Otises are said to be 'not afraid of ghosts' — that is the family's scepticism about the STORY, and it sits fifty lines past this window. Inside the window, lines 26 and 27 answer the stem: Mrs Otis says 'I don't at all care for blood-stains in a sitting-room. It must be removed at once' — she addresses the mess and never the tale.",
    "itsSha256": "6843f51ef2f9ffcce44f282c7728ff92d3cf14de64f54218b0944e4bd66a7ebf",
    "THE_TEXT_IN_THE_CROSSED_ARTEFACT": "Lines 24 to 27 give no view on the story; she answers the mess instead.",
    "itsSha256Crossed": "31589a593b89ffa6a663d84c2372b7f3423ba0a22ed1b790107065d6940b99d8"
   }
  ]
 },
