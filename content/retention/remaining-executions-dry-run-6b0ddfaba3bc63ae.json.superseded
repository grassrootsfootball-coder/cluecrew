   },
   {
    "itemId": "ENG-008-RC-01",
    "district": "ENGLISH",
    "optionValue": "By shouting at her to wake up.",
    "seatTag": "en-wrong-scope-retrieval",
    "sourceFile": "eng008draft (2).json",
    "sourceDigest": "8629bccc1ecfc2c0",
    "THE_TEXT_IN_THESE_ROWS": "Roberta does shout, at line 4, and that is after Phyllis has begun to stir. In the window, line 1 answers the stem: 'Next morning Roberta woke Phyllis by pulling her hair'.",
    "itsSha256": "41b3856d2229aa2c7ad6ee699bb0aae0ec0d183c7501f1ffa3b779ffb7c1cae4",
    "THE_TEXT_IN_THE_CROSSED_ARTEFACT": "Roberta does shout, at line 4, and that is after Phyllis has begun to stir.",
