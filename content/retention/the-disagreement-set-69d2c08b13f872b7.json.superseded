{
 "kind": "THE-DISAGREEMENT-SET-TWO-INSTRUMENTS-ONE-POPULATION",
 "TO": "Annie, by relay through David; the authoring store",
 "date": "2026-09-05",
 "THE_QUESTION": "both instruments over one word population, counted at 3.0 — does the district have one rule or two?",
 "THE_POPULATION": {
  "what": "the district's own adjudication surface: for every vr-08 row and every letter of word1, the leftover and every insertion of that letter into word2, plus both stem words",
  "size": 685,
  "fromRows": 38,
  "andWHYNOTABIGGERLIST": "a disagreement on a word this district never asks about costs nothing. This is the set where the cut actually decides something."
 },
 "THE_TWO_INSTRUMENTS": {
  "thisStore": {
   "cut": 3,
   "ruling": "Annie, 224th return — validity is what a competent eleven-year-old knows, not what a broad dictionary holds. The cut is 3.0.",
   "instrument": {
    "source": "SUBTLEX-UK (van Heuven, Mandera, Keuleers & Brysbaert 2014), Zipf scale, British English",
    "sha256": "e40d83af55eb85e9e2bc0d72e1022b10e47e31ff2086ad2edcc18292d6bd6616",
    "retrievedOn": "2026-09-05",
    "rows": 160024,
    "column": "LogFreq(Zipf)",
    "columnIsAREADINGNotARuling": "Annie ruled the CUT (3.0), not the COLUMN. The primary here is a reading, not a ruling, and every emission carries the CBBC Zipf beside it so the reading can be checked."
   },
   "nameFilter": {
    "rule": "entries whose DomPoS is \"name\" are excluded from the lexicon entirely, whatever their Zipf",
    "whyItIsPartOfTHEMEASUREMENT": "GOVE reads 3.74, SARK 3.37 and BAIN 3.17 — three dialect remainders the ruling exists to exclude, admitted by the bare cut because subtitle corpora lowercase proper nouns into the word list. A store told only \"3.0\" would admit them and be faithful to the ruling as written.",
    "andWHATITCOSTS": "it over-excludes: minister, south and god are DomPoS \"name\" here too, and AllPoS cannot separate them (it reads .name.noun. for minister and for gove alike). A verdict resting on an excluded word reports EXCLUDED-AS-A-NAME, never \"unknown\"."
   },
   "andWHYTHISTRAVELS": "the authoring store runs wordfreq 3.1.1 and reads GRAN at 3.44. Two honest instruments disagree, so a cut without its instrument is not a shared fact. Quote this block back with any figure taken at this cut and the two stores can find the disagreement instead of inheriting it.",
   "knownDisagreementToQuOTEBACK": "GRAN: the authoring store reads 3.44 on wordfreq 3.1.1. This store's own reading is carried as GRAN_measuredHere beside this block, measured at call time rather than written here — a number typed into a declaration is the thing this rule exists to stop."
  },
  "otherStore": {
   "source": "wordfreq 3.1.1, en, Zipf scale",
   "runWHERE": "installed and run HERE, so both halves of this set are measured rather than one being estimated",
   "confirmedAgainstYourOwnFIGURE": "you reported GRAN at 3.44 on wordfreq 3.1.1; run here it returns 3.44. That match is how this side knows it is running your instrument and not an approximation."
  },
  "GRAN": {
   "subtlex": 3.67,
   "wordfreq": 3.44
  }
 },
 "THE_ANSWER": {
  "crossingsOnTHECORPORAALONE": 14,
  "crossingsWITHTHISSTORESNAMERULE": 18,
  "ofPopulation": 685,
  "agreementRate": "97.4%",
  "andWHATTHATMEANS": "18 word(s) of 685 cross the cut in opposite directions. Every OTHER word in the district is corroborated by two independent corpora, which is the stronger agreement you named.",
  "theNameFilterIsARULEDIFFERENCEnotACORPUSONE": "10 word(s) change verdict here BECAUSE of the name filter, which the other store does not apply. That is where the district has two rules rather than two instruments, and it is the half that can be reconciled by a ruling instead of by a corpus."
 },
