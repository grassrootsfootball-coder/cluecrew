{
 "kind": "boundary-conformance-cases",
 "RECROSS": "FIFTH CROSSING. The first two rode inside the membership artefact and did not arrive; the second stood alone and did not arrive. Renamed so it cannot be mistaken for either, with the digest of its own findings inline below and the file digest in the filename.",
 "what": "THE EIGHT BOUNDARY CASES, crossed alone because twice they did not arrive inside the membership. Every value computed by running packages/core — none typed by hand.",
 "theMigrationOrderThisSERVES": "Cowork aliased frameTokenSpans and isExemptByFrame rather than deleting them, on the grounds that a migration proved against the wrong fixture is proved against nothing. This is the right fixture. When these eight pass there, the alias names go.",
 "THE_EIGHT_CASES": [
  {
   "class": "letters BOTH sides of the blank",
   "fn": "gapMarkerSpans",
   "text": "The word stops at DE___VE.",
   "why": "her cited frame; the whole mark or nothing",
   "expect": [
    [
     18,
     25
    ]
   ],
   "marks": [
    "DE___VE"
   ]
  },
  {
   "class": "a LONE capital at the tail of the mark",
   "fn": "gapMarkerSpans",
   "text": "See where the word splits: COM___E.",
   "why": "the run rule needs two capitals, so E is never ASKED about — but it must be INSIDE the span or the mark is not the token",
   "expect": [
    [
     27,
     34
    ]
   ],
   "marks": [
    "COM___E"
   ]
  },
  {
   "class": "letters LEFT of the blank only",
   "fn": "gapMarkerSpans",
   "text": "The frame reads SH___.",
   "why": "the string the crossing turned on",
   "expect": [
    [
     16,
     21
    ]
   ],
   "marks": [
    "SH___"
   ]
  },
  {
   "class": "letters RIGHT of the blank only",
   "fn": "gapMarkerSpans",
   "text": "Look at the frame ___AN.",
   "why": "the mirror; a rule that handles one side is half a rule",
   "expect": [
    [
     18,
     23
    ]
   ],
   "marks": [
    "___AN"
   ]
  },
  {
   "class": "the PREDICATE on letters before the blank",
   "fn": "capitalRunIsExempt",
   "args": [
    "explanation",
    "walkScript",
    "The word stops at DE___VE.",
    18,
    20
   ],
   "text": "The word stops at DE___VE.",
   "run": "DE",
   "runSpan": [
    18,
    20
   ],
   "why": "the tokeniser being right does not make the predicate right — this is the question her ruling actually asked",
   "expect": true
  },
  {
   "class": "the PREDICATE on letters after the blank",
   "fn": "capitalRunIsExempt",
   "args": [
    "explanation",
    "walkScript",
    "The word stops at DE___VE.",
    23,
    25
   ],
   "text": "The word stops at DE___VE.",
   "run": "VE",
   "runSpan": [
    23,
    25
   ],
   "why": "the far side of the same mark; a predicate reading only the left of a span passes the case above and fails here",
   "expect": true
  },
  {
   "class": "the PREDICATE where the frame OPENS with the blank",
   "fn": "capitalRunIsExempt",
   "args": [
    "explanation",
    "walkScript",
    "Look at the frame ___AN.",
    21,
    23
   ],
   "text": "Look at the frame ___AN.",
   "run": "AN",
   "runSpan": [
    21,
    23
   ],
   "why": "no letters precede the underscores, so a predicate that looks backwards from the run finds nothing",
   "expect": true
  },
  {
   "class": "THE CONTROL — a capital run with NO marker anywhere",
   "fn": "capitalRunIsExempt",
   "args": [
    "explanation",
    "walkScript",
    "OUT makes SHOUT, and shouting wakes the baby.",
    0,
    3
   ],
   "text": "OUT makes SHOUT, and shouting wakes the baby.",
   "run": "OUT",
   "runSpan": [
    0,
    3
   ],
   "why": "two implementations that exempt everything also agree. This is the case that distinguishes agreement from surrender, and it must be FALSE on both sides.",
   "expect": false
  }
 ],
