  {
   "itemId": "ENG-005-BB-12",
   "optionText": "That the people never speak to Beauty at all.",
   "field": "misconceptionExecution",
   "landsAs": "column",
   "value": "Reads past the fact that they do speak to him, at lines 36, 40 and 49."
