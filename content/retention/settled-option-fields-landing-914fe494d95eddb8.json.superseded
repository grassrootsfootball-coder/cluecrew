  },
  {
   "itemId": "ENG-005-BB-12",
   "optionText": "That Beauty is too frightened to listen properly.",
   "field": "misconceptionExecution",
   "landsAs": "column",
   "value": "Swaps the evidenced limit, understanding, for a feeling the passage does not give."
