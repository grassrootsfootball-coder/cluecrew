   "FRAME": 60
  },
  "byStatus": {
   "DRAFT": 2187,
   "LIVE": 1173,
   "RETIRED": 6,
   "NEVER_SHIPPABLE": 104
  },
  "andWhatWasScreenedOUT": "every string on a screened path that claims NO exemption — the ordinary corpus. This file is the exempt population only, so its size is not a fault count and is not comparable to one (R591)."
 },
 "THE_ANSWER_PER_CLASS": {
  "accessibleTextEXISTS": {
   "OPTION_VALUE: NONE": 3376,
   "GAP_MARKER: UNKNOWN": 34,
   "FRAME: NONE": 40,
   "FRAME: UNKNOWN": 20
  },
  "theShape": "a GAP_MARKER in a cloze stem names itself (\"gap N\", R668) and a FRAME never does. The split is not by quality — it is by which renderer the path reaches, and only one renderer in the corpus was built to name a marker.",
  "andTheSHARPEST": "40 rows carry a token containing underscores AND have no substitute accessible text. Those are the rows where a child listening receives characters that do not speak, with nothing else offered. That is the membership her flag asked for; it is not a ruling that they are wrong.",
  "UNKNOWN": "54 rows on 5 (family, path) pairs whose renderer has not been read. Reported UNKNOWN, never as \"none exists\".",
  "unknownPairs": [
