// ClueCrew data model — BUILD-PHASE-1 §3. Model names are law (manifesto §7):
// Case, CaseFile, Rank, WordVault, District. Naming drift fails review.
//
// Data minimisation is structural, not procedural (S1): there is NO field for
// a child's surname, date of birth, school name, photo, or free-text "about me".
// Adding one requires a manifesto amendment first.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ---------- Accounts and families (§3.1) ----------

model ParentAccount {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String // argon2id
  emailVerified DateTime?
  displayName   String // how we address the parent, e.g. "David"
  regionCode    String? // 11+ region, set by onboarding wizard (Phase 2)
  targetSchools Json? // [{name, examBoard, examDate}] — parent-entered
  // Auth throttling (§4): lockout with email notification on repeated failures
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  // Admin CMS access (BUILD-PHASE-2 §5). Parents are NONE; staff roles gate /admin.
  staffRole     StaffRole @default(NONE)
  // Staff 2FA (Phase 2 §5 hardening, 2026-08-01): TOTP is enrolled during
  // invite acceptance and required at every staff sign-in thereafter.
  totpSecret    String?
  totpEnabledAt DateTime?
  // One-tap unsubscribe from the weekly email (BUILD-PHASE-5 §4) —
  // never touches transactional email.
  weeklyOptOut  Boolean   @default(false)

  consentLog          ConsentEvent[]
  children            ChildProfile[]
  subscription        Subscription?
  verificationTokens  VerificationToken[]
  bursaryApplications BursaryApplication[]
  plusWaitlist        PlusWaitlistEntry?

  createdAt DateTime  @default(now())
  deletedAt DateTime? // soft delete; hard-delete job runs after 30 days

  @@index([deletedAt])
}

model ChildProfile {
  id        String  @id @default(cuid())
  parentId  String
  parent    ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
  crewName  String // first name or nickname ONLY — no surname field exists
  // ADDENDUM-D §1: the year model. A static year group goes stale every
  // 1 September, so the effective year group is ALWAYS derived —
  // yearGroupAtCapture + (currentAcademicYear − capturedAcademicYear),
  // computed in @cluecrew/core year.ts and never stored denormalised.
  yearGroupAtCapture   Int // Years 3–6 at the moment of capture
  capturedAcademicYear Int // e.g. 2026 = academic year 2026/27
  examYear             Int? // e.g. 2028 — drives programme pacing
  settings  Json // accessibility prefs: reducedMotion, dyslexiaFont, audioDefault
  rank      Rank    @default(TRAINEE)
  // Streak weeks earned (rank input). Forgiveness days are never stored —
  // they are computed transiently and invisible by design (D2).
  streakWeeks Int   @default(0)
  // The single permitted mode pointer (L2 firewall): a UI convenience only.
  // No other mode-choice data may ever be stored — reviewer instruction:
  // reject any PR adding a learner-profile column or score here. See
  // packages/core/src/modes.ts for the full firewall text.
  lastUsedMode String?

  caseFiles       CaseFile[]
  wordVault       WordVaultEntry[]
  attempts        Attempt[]
  sessions        Session[]
  reviewSchedules ReviewSchedule[]
  mockSittings    MockSitting[]
  readinessSnapshots ReadinessSnapshot[]
  reviewRecordings   ReviewRecording[]

  createdAt DateTime  @default(now())
  deletedAt DateTime?
}

enum StaffRole {
  NONE
  AUTHOR
  REVIEWER
  ADMIN
}

enum Rank {
  TRAINEE
  JUNIOR_DETECTIVE
  DETECTIVE
  SENIOR_DETECTIVE
  CHIEF_INSPECTOR
}

model ConsentEvent {
  id        String        @id @default(cuid())
  parentId  String
  parent    ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
  kind      String // "tos", "privacy", "child_profile_created", "writing_review_notice", "marketing_optin"
  version   String // policy version consented to
  createdAt DateTime      @default(now())
}

// Email verification (§4: parent verifies email before any child profile exists)
model VerificationToken {
  id        String        @id @default(cuid())
  parentId  String
  parent    ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
  tokenHash String        @unique // sha-256 of the emailed token; raw token never stored
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
}

// ---------- Subscription (§3.2 — schema only; Stripe wiring is Phase 2) ----------

model Subscription {
  id                String        @id @default(cuid())
  parentId          String        @unique
  parent            ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
  tier              Tier
  stripeCustomerId  String?
  stripeSubId       String?
  status            String // trialing | active | past_due | canceled
  // Trial: 7 days, NO card required (BUILD-PHASE-2 §1); card collected at conversion only.
  trialEndsAt       DateTime?
  // Bursary flag — capacity accounting and aggregate reporting ONLY.
  // Grep-level guarantee: no child- or parent-facing UI ever reads this (§6).
  isBursary         Boolean       @default(false)
  firstPaidAt       DateTime? // anchors the 14-day cooling-off window (§2.2)
  canceledAt        DateTime?
  commitmentEndsAt  DateTime? // for DMCC-compliant display of total contract value
  renewalReminderAt DateTime? // next scheduled reminder (T-14 then T-3) (L5)
  // Stripe event ordering guard: webhooks apply only if newer than this.
  lastStripeEventAt DateTime?
  createdAt         DateTime      @default(now())
}

// AMENDMENT-1 §1: the Pricing V2 ladder. CREW (free) holds no Subscription
// row at all — absence of a subscription IS the free tier, so free can never
// silently convert to paid. Bursary is FULL_24 + isBursary (identical
// product, §1).
enum Tier {
  FULL_24
  FULL_12
  FULL_ROLLING
  PLUS_ROLLING
  SUMMER
}

// Processed Stripe webhook ids — makes the handler idempotent under replay (§2).
model WebhookEvent {
  id          String   @id // Stripe event id
  type        String
  processedAt DateTime @default(now())
}

model BursaryApplication {
  id           String        @id @default(cuid())
  parentId     String
  parent       ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
  status       BursaryStatus @default(RECEIVED)
  confirmation String // "fsm" | "pupil_premium" — self-confirmation basis
  // Evidence is AES-256-GCM encrypted at rest and hard-deleted 30 days after decision (§6).
  evidence     Bytes?
  evidenceName String?
  evidenceMime String?
  decidedAt    DateTime?
  decidedById  String?
  evidencePurgeAt DateTime?
  createdAt    DateTime      @default(now())

  @@index([status, createdAt])
}

enum BursaryStatus {
  RECEIVED
  APPROVED
  DECLINED
  WAITLISTED
}

// Audit log on all admin actions (BUILD-PHASE-2 §5).
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String // e.g. "item.publish", "bursary.approve", "region.update"
  targetKind String
  targetId   String
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetKind, targetId])
}

// Region Registry (BUILD-PHASE-2 §3.3): seeded from /content/regions.json,
// maintained via the admin CMS with source URL + last-verified date.
model Region {
  id               String   @id // code slug, e.g. "kent"
  name             String
  examFormat       String // gl-style | csse | set | school-specific | mixed | unknown
  formatSummary    String
  typicalTestMonth String
  subjects         District[]
  exampleSchools   Json
  notes            String?
  sourceUrl        String
  lastVerified     DateTime
  updatedAt        DateTime @updatedAt
}

// ---------- Item bank (§3.3) ----------

model QuestionType {
  id       String   @id // stable slug: "vr-08-move-letter"
  district District
  name     String
  glCode   String? // GL familiarisation numbering where applicable
  mechanic String // slug of the game mechanic that renders it
  items    Item[]
  cases    Case[]
}

enum District {
  VR
  NVR
  MATHS
  ENGLISH
}

model Item {
  id                   String       @id @default(cuid())
  questionTypeId       String
  questionType         QuestionType @relation(fields: [questionTypeId], references: [id])
  difficultyTier       Int // 1–5 authored estimate; live calibration adjusts calibratedDifficulty
  calibratedDifficulty Float? // updated nightly from attempt data
  stem                 Json // structured content, never HTML strings
  options              ItemOption[]
  explanation          Json // per-mode explanation asset refs (watch/walk/see/hear)
  status               ItemStatus   @default(DRAFT) // DRAFT → REVIEWED → LIVE → RETIRED
  // ADDENDUM-B §1: which serving world this item belongs to. MOCK items are
  // new volume on top of the practice gates, never a reclassification of
  // practice items a child may already have met.
  pool                 ItemPool     @default(PRACTICE)
  authoredBy           String // "human:<name>" | "ai-draft:<model>" | "seed" — provenance is mandatory
  reviewedBy           String? // human reviewer name; REQUIRED before LIVE (P3, AI-QC)
  reviewNotes          String? // reviewer feedback when an item is returned to DRAFT
  // Verbal-decision provenance, same rule as Misconception above: whose
  // judgement (`reviewedBy`) is never merged with who entered it
  // (`reviewRecordedBy`). CHECK-constrained in the migration.
  reviewRecordedBy     String?
  reviewMethod         String?
  reviewRecordNote     String?
  // Set by the nightly calibration job when calibrated difficulty drifts
  // ≥1.5 tiers from the authored tier — the live QC net (Phase 3 §2).
  calibrationFlaggedAt DateTime?
  // ADDENDUM-E §3: the similarity gate. A flagged item is blocked from
  // REVIEWED until a reviewer clears it with a note — the gate protects
  // against derivation; the reviewer judges coincidence. Score only, never
  // matched text.
  similarityFlaggedAt  DateTime?
  similarityScore      Float?
  // BUILD-DISTRICT-MATHS §5: the machine-verifiable key. REQUIRED for every
  // MATHS-district item (CI + import both enforce); the correct option is
  // computed from this expression, never asserted. VR items carry null.
  solution             String?
  similarityClearedBy  String?
  similarityClearNote  String?
  // THE ANSWERABILITY FLAG (David's ruling, 2026-08-02). Set by
  // `pnpm check:word-puzzles` when an item's own rule does not produce its
  // key — no valid answer, or a different one. That is not a style problem
  // and not a matter of taste: the child cannot answer it correctly, so no
  // sign-off can make it servable.
  //
  // Deliberately UNLIKE similarityFlaggedAt, which a reviewer may clear with
  // a note. There is no clearing field here. The flag goes when the item is
  // fixed and the gate stops setting it, and by no other route.
  answerFlaggedAt      DateTime?
  answerFlagNote       String?
  // BUILD-DISTRICT-ENGLISH §3: the Selective track's open-response half.
  // Present only on open-response items; GL-track English items are MC and
  // carry options like every other district.
  englishOpenResponse  EnglishOpenResponse?
  englishUnmatchedAnswers EnglishUnmatchedAnswer[]
  createdAt            DateTime     @default(now())

  @@index([questionTypeId, status, pool])
}

enum ItemStatus {
  DRAFT
  REVIEWED
  LIVE
  RETIRED
}

// ADDENDUM-B §1: mock items are held out from practice, permanently. A mock
// only measures if the child has not seen its questions, so MOCK items are
// never served by the practice/warm-up/review engines — enforced in core item
// selection and again at the query in the orchestrator.
enum ItemPool {
  PRACTICE
  MOCK
}

enum MockSittingStatus {
  SCHEDULED // parent booked it; composition is fixed at this moment
  IN_PROGRESS // the child is sitting it
  COMPLETED // burns every served item for this child (Addendum B §1)
  ABANDONED // kind exit; only the sections the child OPENED burn (§3)
}

model ItemOption {
  id              String         @id @default(cuid())
  itemId          String
  item            Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  content         Json
  isCorrect       Boolean
  // The single legacy tag. Kept as the TOPIC tag's cache; the two-role model
  // below is the source of truth for maths (annie, 2026-08-06).
  misconceptionId String? // REQUIRED on every incorrect option before item goes LIVE (P3)
  misconception   Misconception? @relation(fields: [misconceptionId], references: [id])
  tags            ItemOptionTag[]
}

// Two tags per distractor, one TOPIC, one PROCESS (annie's two-ids decision,
// 2026-08-06). Evidence: eight distractors across eight topic ids are all one
// process ("stop-early") — a pattern one tag dissolves and two make visible.
// The PROCESS tag owns the child-facing hint and is the DERIVABLE one the gate
// executes; the TOPIC id carries domain teaching in the walk script. @@unique
// keeps it to at most one of each role per option (extensible to more processes).
enum MisconceptionTagRole {
  TOPIC
  PROCESS
}

model ItemOptionTag {
  id              String               @id @default(cuid())
  optionId        String
  option          ItemOption           @relation(fields: [optionId], references: [id], onDelete: Cascade)
  misconceptionId String
  misconception   Misconception        @relation(fields: [misconceptionId], references: [id])
  role            MisconceptionTagRole
  createdAt       DateTime             @default(now())

  @@unique([optionId, role])
  @@index([misconceptionId])
}

// ADDENDUM-E §2: corpus-proposed misconceptions land as PROPOSED and are
// unusable by items until a named reviewer approves them. Corpus findings are
// evidence, not instructions — the approval is the door.
enum MisconceptionStatus {
  PROPOSED
  ACTIVE
  // Soft reject (David's ruling, 2026-08-02): a rejected proposal is kept,
  // not deleted. A mis-click during a review sitting used to destroy corpus
  // evidence with no undo; now it changes a status that an admin can put
  // back. REJECTED is as unusable by items as PROPOSED — only ACTIVE serves.
  REJECTED
}

model Misconception {
  id          String       @id // slug: "vr-analogy-surface-match"
  district    District
  description String // teacher-facing
  childHint   String // the authored hint shown when this distractor is chosen
  status      MisconceptionStatus @default(ACTIVE)
  /** "ai-corpus:v1" for corpus-proposed entries (Addendum E §2). */
  proposedBy  String?
  /** Corpus pattern reference — an opaque citation id, never source text. */
  sourcePattern String?
  /** The reviewer's own grouping of a seed misconception (e.g. the six KS2
   *  maths strands). Editorial provenance, not a serving field. */
  category    String?
  /** Vocabulary this misconception's hint is ABOUT (e.g. "isosceles",
   *  "equilateral") — exempt from the long-word ceiling on THIS hint only,
   *  the same bounding as headwordInOwnCard. Read by every gate that screens
   *  the hint, so the exemption is stored once and honoured everywhere. */
  testedTokens String[]
  /** "human:<email>" — the REVIEWER whose judgement this is. Approval activates. */
  approvedBy  String?
  // Verbal-decision provenance (David's ruling, 2026-08-02). A reviewer may
  // decide in a sitting and an admin may enter it afterwards. The two are
  // different people doing different things and the record must never merge
  // them: `approvedBy` is whose judgement it was, `recordedBy` is who typed
  // it in. A CHECK constraint in the migration enforces that a recorded
  // approval names both and that they differ — self-recording would launder
  // an admin's own approval into a reviewer's name.
  /** "human:<email>" — the ADMIN who entered a decision made elsewhere. */
  recordedBy  String?
  /** e.g. "verbal — sitting #1, 2026-08-01", or absent when done in-platform. */
  approvalMethod String?
  /** What the reviewer actually said — the only place nuance survives. */
  approvalNote   String?
  /** "human:<email>" — who rejected it, kept so a restore has a history. */
  rejectedBy     String?
  rejectedAt     DateTime?
  rejectionNote  String?
  // Teach-Back content (Phase 3 §6): authored working steps, the index of the
  // step containing the slip, and authored correction options. The engine
  // never generates text (S3) — evaluation is deterministic.
  teachback   Json?
  options     ItemOption[]
  optionTags  ItemOptionTag[]
  // The two-ids AXIS (annie, 2026-08-06): PROCESS ids (PROC-01, #71/#72/#99/#100)
  // are cross-topic and own the child-facing hint; null/absent means a TOPIC id.
  axis        MisconceptionTagRole?
  // Added 2026-08-06: the reviewer-handover audit could not be timelined
  // because these rows had no birth date. Existing rows stamp the migration
  // time, not their true authorship — the real epoch lives in AttributionEvent.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

// Reviewer-handover attribution (2026-08-06). approvedBy/signedBy name a single
// generic REVIEWER role account, so they cannot say WHICH human authored,
// approved or amended a record — and some records are two-person (a predecessor
// authored the maths library entry, the current reviewer corrected it). This
// append-only log records each touch as its own event: the individual actor,
// what they did, and — crucially — who typed it (recordedBy stays David). A
// reassignment is itself an event, so no correction is ever silent. The
// denormalised approvedBy/signedBy columns are left untouched as a role cache.
enum AttributionAction {
  AUTHORED
  APPROVED
  AMENDED
  SIGNED
  REASSIGNED
  UNATTRIBUTED
}

model AttributionEvent {
  id         String            @id @default(cuid())
  /** "misconception" | "item" | "nvr-signature" | "word" */
  recordType String
  /** target id; composite keys use "templateId@version" */
  recordId   String
  action     AttributionAction
  /** the INDIVIDUAL — "previous-reviewer" | "current-reviewer" | "unattributed" */
  actor      String
  /** who typed it in — David. The working half of the design, kept explicit. */
  recordedBy String
  /** which field this touch changed, e.g. "description" */
  field      String?
  note       String?
  method     String?
  /**
   * FINGERPRINT OF THE THING SIGNED (annie, 2026-08-08) — the same guard that
   * made the NVR signatures work (`NvrTemplateSignature.sampleSheetHash`).
   *
   * A SIGNED event's `note` carries figures about what was signed: the depth of
   * a family, the ladder it exercises, the size of its bank. Those are prose.
   * Regenerate the family — widen a bank, re-tier a rung — and the note goes on
   * asserting the old numbers with nothing to contradict it. The signature then
   * describes a family that no longer exists, and reads as though it still does.
   *
   * This column pins it: the hash of the family's generator surface (tier rules,
   * structural parameters, ranges, bank content) as it stood at signing. If the
   * family moves, `pnpm audit:signed-depth` reports the signature as describing
   * a superseded version rather than leaving the reviewer to notice.
   *
   * Null on events that sign no generated artefact (a misconception approval).
   */
  subjectHash String?
  at         DateTime          @default(now())

  @@index([recordType, recordId])
  @@index([actor])
}

// ---------- English district, Selective track (BUILD-DISTRICT-ENGLISH §3) ----------

// The open-response item model — the district's engineering core. It HANGS
// OFF Item rather than replacing it, so the existing reviewer door is reused
// and not duplicated: review status (DRAFT → REVIEWED → LIVE → RETIRED),
// authoredBy/reviewedBy provenance, the pool split and the similarity gate
// all stay on the Item row and mean exactly what they mean everywhere else.
// The stem lives on Item.stem; everything here is the marking apparatus.
//
// Reviewer note recorded in the spec (§3): reviewing one of these is
// mark-scheme drafting, not distractor checking — slower per item, and
// scoped accordingly in sittings.
//
// The engine that reads these rows is packages/core/src/english. Its publish
// gate (validateForPublish) is the door a row must pass before the Item may
// go LIVE: no acceptable answers, an out-of-range tariff, or a GRADUATED item
// with an incomplete ladder are all refusals.
model EnglishOpenResponse {
  itemId String @id
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /** The curated extract this question reads (Stream A/B/C, §6). */
  passageRef String
  /** [{ from, to }] — "lines 12–18", as the papers phrase it. */
  lineRefs   Json
  /** 1–12 marks. The range is enforced by the core publish gate. */
  tariff         Int
  /** Papers routinely state "give two reasons". */
  requiredPoints Int?
  /** [{ text, tolerance, barredNearMisses, conceptSets, pointId, rung,
   *  feedback, misconceptionId }] — validated by openResponseItemSchema. */
  acceptableAnswers Json
  creditModel       EnglishCreditModel @default(POINT)
  /** [{ level, descriptor, exampleAnswer, marks }] — one per ladder rung,
   *  required in full for GRADUATED credit (§4, gate #1). */
  bands             Json
  /** Unsupported general answers hit a ceiling. */
  evidenceCapRule   Boolean @default(false)
  /** Lifting from the passage scores zero on these. */
  ownWordsRequired  Boolean @default(false)
  /** CSSE-style embedded accuracy mark, scored and reported separately. */
  spagRider         Int?
  /** Authored, neutral, never a criticism — gate #9 refuses the item without
   *  it, because a bare number is not something a child can be shown. */
  spagRiderLabel    String?
  /** [{ kind, barredSpellings }] — authored checks only; there is no
   *  dictionary and no invented judgement of a child's spelling. */
  spagRiderChecks   Json?
  /** §3: misconceptions tag ANSWER PATTERNS, not options. Ids reference
   *  Misconception rows, which carry their own PROPOSED → ACTIVE door. */
  misconceptionIds  String[]
  createdAt DateTime @default(now())
}

enum EnglishCreditModel {
  POINT
  GRADUATED // the ladder (§4)
}

// Gate #2, second half: unmatched answers are logged for reviewer sampling so
// the acceptable-answer set improves over time.
//
// DATA DECISION (S1/S5), recorded here because it is the only place it is
// visible: this table holds child free text, and the repo's standing position
// on child free text is that it does not get stored (Event props are IDs and
// enums; there is no free-text column on ChildProfile; the columns simply do
// not exist). Sampling needs the WORDS to be useful, so the concession made
// is the narrowest one that still serves the purpose:
//
//  - NO childId, sessionId or attemptId. The row is a note about an ITEM, and
//    nothing in the schema can link it to the child who typed it. That is why
//    it is not on the account cascade-delete path — there is no person here
//    to delete.
//  - The text stored is NORMALISED and REDACTED by the core engine
//    (buildUnmatchedAnswerLog): case and punctuation gone, digits, emails and
//    postcode shapes stripped, capped at 300 characters.
//  - Only the engine may create a row: it returns null for every outcome that
//    was already authored (blank, a barred near miss, a detected lift), so the
//    only answers kept are the ones nobody has an answer for yet.
//  - purgeAt is set on write and a purge job honours it. Nothing here is kept
//    because it might be useful later.
//
// Residual risk, stated plainly: a first name typed mid-sentence is not
// detectable by any deterministic rule, so redaction cannot be complete. The
// mitigations are the absent child link, the length cap, reviewer-only access
// and the purge date. This needs a DPIA §2 inventory row before the district
// serves a real child.
model EnglishUnmatchedAnswer {
  id     String @id @default(cuid())
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /** Normalised + redacted; never the raw keystrokes. */
  normalisedAnswer String
  tokenCount       Int
  /** Best coverage of any authored answer — how near a miss it was. */
  bestCoverage     Float
  /** CompareReason values from the engine — enums, never a sentence. */
  reasons          String[]
  status     EnglishSampleStatus @default(SAMPLED)
  /** "human:<email>" — set when a reviewer acts on the sample. */
  reviewedBy String?
  reviewNote String?
  createdAt  DateTime @default(now())
  /** Set on write; the purge job deletes on this date regardless. */
  purgeAt    DateTime

  @@index([itemId, status, createdAt])
  @@index([purgeAt])
}

enum EnglishSampleStatus {
  SAMPLED // waiting for a reviewer
  ACTIONED // the acceptable-answer set was widened because of it
  DISMISSED // reviewed and not creditworthy; the item stands
}

model Case {
  id              String       @id // slug: "case-vr-08"
  questionTypeId  String
  questionType    QuestionType @relation(fields: [questionTypeId], references: [id])
  title           String // child-facing case name
  narrativeIntro  Json // ≤30s of story (D5)
  modes           Json // asset manifest for the five Modes (P1)
  orderInDistrict Int
  // AMENDMENT-1 §5.1: the free Crew tier's open cases — the genuine front
  // door, pedagogy never crippled. Selection ratified by David + reviewer;
  // default is the first two per engine family by orderInDistrict.
  freeTier        Boolean    @default(false)
  // STORY BIBLE v1.2 §9 (phase 1, feature-flagged): the per-case story skin —
  // open/close lines + clue-skin labels. Law 1: wraps the case, never items.
  storyWrapper    Json?
  caseFiles       CaseFile[]
}

model CaseFile {
  id           String       @id @default(cuid())
  childId      String
  child        ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  caseId       String
  case         Case         @relation(fields: [caseId], references: [id])
  masteryLevel Float        @default(0) // 0–1; mastery model in /packages/core
  solvedAt     DateTime? // case "cracked"
  taughtBackAt DateTime? // Teach-Back badge (Phase 3 §6)
  lastPracticedAt DateTime? // drives lazy mastery decay (Phase 3 §1)
  // Adaptivity persistence (Phase 3 §2): estimate + rolling outcome window
  // survive across sessions. These are engine state, not analytics.
  tierEstimate Int @default(2)
  recentOutcomes Json @default("[]")
  attemptCount Int @default(0)
  // When the case opened for this child — the new-case pacing signal
  // (Addendum D §2). Backfilled with the migration date for older rows.
  createdAt DateTime @default(now())

  @@unique([childId, caseId])
}

// ---------- Practice, scheduling, vocabulary (§3.4) ----------

model Attempt {
  id             String       @id @default(cuid())
  childId        String
  child          ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  itemId         String
  sessionId      String
  chosenOptionId String?
  correct        Boolean
  latencyMs      Int
  context        String // "case_practice" | "warmup_review" | "boss_case" | "word_vault"
  createdAt      DateTime     @default(now())

  @@index([childId, createdAt])
}

model ReviewSchedule {
  id           String       @id @default(cuid())
  childId      String
  child        ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  unitKind     String // "question_type" | "word"
  unitId       String
  dueAt        DateTime
  intervalDays Float
  easeFactor   Float        @default(2.3)
  lapses       Int          @default(0)

  @@unique([childId, unitKind, unitId])
  @@index([childId, dueAt])
}

// Word cards had NO review door until 2026-08-02: anything written to this
// table was immediately collectable by a child. The corpus vault import made
// that untenable — 180 AI-drafted cards cannot go straight to children — so
// Word now carries the same DRAFT→LIVE discipline Item has, and every
// child-facing query filters on it.
enum WordStatus {
  DRAFT // authored or imported; never served to a child
  LIVE // reviewer-approved
  RETIRED
}

model Word {
  id              String           @id // slug of the word
  headword        String
  definitionChild String // authored, reading age ≤9 (sense A)
  sentence        String
  rootFamily      String? // "latin-port", "greek-tele" — the primary family
  imageRef        String?
  tier            Int // frequency/difficulty tier 1–5
  // Fails closed: a row written without an explicit status cannot be served.
  status          WordStatus       @default(DRAFT)
  /** "seed" | "ai-draft:<model>" | "human:<email>" — provenance is mandatory. */
  authoredBy      String?
  /** "human:<email>" — set by reviewer approval; required before LIVE. */
  reviewedBy      String?

  // --- Polysemy (the "Two Meanings" pool source) --------------------------
  // A card with two senses is a different teaching object from a card with
  // one: it is the raw material for two-meanings questions, and the child
  // must meet both senses honestly. senseB is CHECK-constrained to exist
  // whenever twoMeanings is true.
  twoMeanings      Boolean @default(false)
  wordClass        String?
  senseBDefinition String?
  senseBSentence   String?
  senseBWordClass  String?
  /** "A" | "B" — which sense a child is likelier to already hold. */
  likelierKnown     String?
  likelierKnownNote String?

  /** The incoming cards carry a LIST of families; rootFamily keeps the first. */
  rootFamilies String[] @default([])
  imagePrompt  String?
  imagePromptB String?
  /** The authoring pass's own verdict, kept as provenance, never as approval. */
  preReviewVerdict String?
  /** Set when this card replaced an earlier one: the old values and the ruling. */
  supersedeNote String?
  /** Reviewer feedback when a card is returned for redraft (mirrors Item). */
  reviewNotes   String?

  vaultEntries WordVaultEntry[]

  @@index([status, tier])
  @@index([twoMeanings, status])
}

model WordVaultEntry {
  id           String       @id @default(cuid())
  childId      String
  child        ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  wordId       String
  word         Word         @relation(fields: [wordId], references: [id])
  collectedAt  DateTime     @default(now())
  masteryLevel Float        @default(0)

  @@unique([childId, wordId])
}

model Session {
  id            String       @id @default(cuid())
  childId       String
  child         ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  startedAt     DateTime     @default(now())
  endedAt       DateTime?
  secondsActive Int          @default(0) // 15-min cap enforcement (D2) reads this
  // Serialized engine state (packages/core session reducer). The engine is
  // pure; this row is just its persistence.
  engineState Json?
  // Optimistic concurrency for engineState. Every read carries this number and
  // every write requires it to be unchanged, so two overlapping requests can
  // no longer both read the same state, both mutate it, and both save — which
  // silently discarded whichever landed first. The loser is told (409) and the
  // client reloads the real activity. See apps/web/lib/crew/orchestrator.ts.
  stateVersion Int @default(0)
}

// ADDENDUM-B §5: one sat (or scheduled) mock paper. Feeds parent reporting,
// the burn rule, the Stage-2 cohort stats when they arrive, and (aggregated,
// consented) the L1 evidence base. No new personal data: item ids, timings and
// option choices only — same classes of data the practice engine already
// stores per attempt. DPIA note appended (docs/dpia.md).
// AMENDMENT-1 §3: the Crew Plus monthly teacher review — a recorded ~5-minute
// video addressed to the PARENT about the child, never child-facing, checked
// before release. Videos deleted 12 months after the subscription ends.
model ReviewRecording {
  id        String       @id @default(cuid())
  childId   String
  child     ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  /** The month this review covers, e.g. "2026-08". One per child per month. */
  month     String
  /** Reference into private media storage — never a public URL. */
  videoRef  String?
  /** Teacher self-attestation against the recording checklist (§3). */
  checklistAttestedBy String?
  /** DSL/admin spot-check before release. */
  spotCheckedBy String?
  status    ReviewRecordingStatus @default(QUEUED)
  releasedAt DateTime?
  createdAt DateTime @default(now())

  @@unique([childId, month])
  @@index([status, createdAt])
}

enum ReviewRecordingStatus {
  QUEUED // Plus month started; awaiting recording
  RECORDED // teacher recorded + checklist attested
  RELEASED // spot-checked and visible to the parent
  CREDITED // month missed: Plus premium auto-credited (§3), no recording
}

// AMENDMENT-1 §3: Plus subscriptions are capacity-capped to the teacher
// bench, with a public waitlist.
// AMENDMENT-1 §1: the Schools register-interest waitlist — demand
// measurement only, nothing built. Business contacts, not families.
// ---------- Demand test (DEMAND-TEST-PACK §3) ----------
// The Founding Crew waitlist: email plus two OPTIONAL fields, nothing else.
// Double opt-in proves consent (confirmedAt). Unconverted rows are deleted
// 12 months post-launch — the privacy notice states this and ops runs it.

model WaitlistSignup {
  id          String    @id @default(cuid())
  email       String    @unique
  regionCode  String?
  yearGroup   Int?
  // UTM source per §4 (fb-kent, org-bucks, …) — measurement, never marketing.
  src         String?
  // Which capture box (V2 §2: demo-end | region-decoder | sticky | hero;
  // V3 adds founding-reserve) — buyer temperatures differ and the mix is
  // itself a finding.
  source      String?
  // Founding-rate reserve fields (LIVE-LAUNCH-PACK-V3 §1 Step 2): explicitly
  // NOT a payment; the rate is honoured at checkout opening. name is only
  // ever collected on the reserve path.
  name        String?
  reservedTier String?
  tokenHash   String    @unique
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
}

// Staff invites (Phase 2 §5, 2026-08-01): an admin adds email + role; the
// invitee sets their own password and enrolls 2FA on acceptance. No
// credential ever travels by hand — the token is single-use and hashed.
model StaffInvite {
  id         String    @id @default(cuid())
  email      String    @unique
  role       StaffRole
  tokenHash  String    @unique
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
}

model SchoolInterest {
  id        String   @id @default(cuid())
  email     String   @unique
  school    String?
  createdAt DateTime @default(now())
}

model PlusWaitlistEntry {
  id        String        @id @default(cuid())
  parentId  String        @unique
  parent    ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
}

model MockSitting {
  id          String            @id @default(cuid())
  childId     String
  child       ChildProfile      @relation(fields: [childId], references: [id], onDelete: Cascade)
  blueprintId String // /content/blueprints/<id>.json — content, not a table
  // Per-section composition fixed at scheduling: [{ itemIds: string[] }, …].
  // Which of these burn for the child depends on status + sectionTimings:
  // COMPLETED burns all; ABANDONED burns only sections with a startedAt (§3).
  servedItemIds Json
  // Per section: { startedAt?: ISO, endedAt?: ISO, secondsUsed?: number }.
  sectionTimings Json
  // { [itemId]: { optionId, correct, answeredAt } } — graded server-side; the
  // child's device never receives an isCorrect flag during the sitting.
  responses Json
  status    MockSittingStatus @default(SCHEDULED)
  // Same optimistic-concurrency guard the Session rows carry, same rationale.
  stateVersion Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([childId, blueprintId, status])
  @@index([childId, createdAt])
}

// BUILD-DISTRICT-NVR §4: the generator-level review model. The reviewer signs
// TEMPLATE VERSIONS, not items; all items from a signed version inherit
// REVIEWED status. The fingerprint is the template's behavioural hash at
// signing time (core nvr/samples.ts templateFingerprint) — if the template's
// behaviour changes without a version bump, serving compares fingerprints and
// treats the signature as voided. Unsigned versions cannot serve (core
// serving door + CI check both enforce).
model NvrTemplateSignature {
  templateId  String
  version     Int
  fingerprint String
  /** "human:<email>" — the specialist reviewer who signed this version. */
  signedBy    String
  signedAt    DateTime @default(now())
  /** contentHash of the 30-per-tier sample sheets the reviewer inspected —
   *  the archived artefact is reproducible byte-for-byte from
   *  (templateId, version), this hash proves what was seen (§4.2). */
  sampleSheetHash String
  /** Set by the quarterly drift check (§4.3). */
  lastDriftCheckAt DateTime?
  notes       String?

  @@id([templateId, version])
}

// ADDENDUM-C §5 (+ Addendum D §5): the readiness picture per child, district
// and target blueprint, recomputed nightly and on session end. Feeds the
// parent readiness meter and the L1 evidence base. Percentages of coverage,
// never a judgement of the child; the child never sees any of it (§6).
model ReadinessSnapshot {
  id          String       @id @default(cuid())
  childId     String
  child       ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  district    String // 'VR' | 'MATHS' | …
  blueprintId String
  coveragePct Int // % of blueprint types at "taught and progressing" (≥0.55)
  crackedPct  Int // % of district cases cracked (≥0.8)
  transferPct Int // rolling Boss Round accuracy, last 20 items
  tier        Int // current adaptive tier estimate for context
  // The D §2 matrix column in force when this was computed.
  intensityColumn String
  computedAt      DateTime @default(now())

  @@index([childId, district, computedAt])
}

// ---------- Analytics spine (§6) ----------
// Append-only. Deliberately no foreign keys: rows are removed by the
// hard-delete job, not by cascade, and must never block account deletion.
// Events NEVER contain free text a child wrote, item content, or anything
// beyond IDs and enums (enforced in code via @cluecrew/core assertEvent).

model Event {
  id        String   @id @default(cuid())
  childId   String?
  parentId  String?
  name      String // canonical names live in packages/core/src/events.ts
  props     Json
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([childId, createdAt])
  @@index([parentId, createdAt])
}

// ---------- Retention (§5: design the aggregation now, enable later) ----------
// Anonymised daily rollup written by the aggregation job for attempt data older
// than the child's exam year + 12 months. No childId — aggregate is by design.

model AggregateDailyStat {
  id             String   @id @default(cuid())
  district       District
  questionTypeId String
  day            DateTime @db.Date
  attempts       Int
  correct        Int

  @@unique([district, questionTypeId, day])
}
