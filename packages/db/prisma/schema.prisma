// ClueCrew data model — BUILD-PHASE-1 §3. Model names are law (manifesto §7):
// Case, CaseFile, Rank, WordVault, District. Naming drift fails review.
//
// Data minimisation is structural, not procedural (S1): there is NO field for
// a child's surname, date of birth, school name, photo, or free-text "about me".
// Adding one requires a manifesto amendment first.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ---------- Accounts and families (§3.1) ----------

model ParentAccount {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String // argon2id
  emailVerified DateTime?
  displayName   String // how we address the parent, e.g. "David"
  regionCode    String? // 11+ region, set by onboarding wizard (Phase 2)
  targetSchools Json? // [{name, examBoard, examDate}] — parent-entered
  // Auth throttling (§4): lockout with email notification on repeated failures
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  // Admin CMS access (BUILD-PHASE-2 §5). Parents are NONE; staff roles gate /admin.
  staffRole     StaffRole @default(NONE)
  // One-tap unsubscribe from the weekly email (BUILD-PHASE-5 §4) —
  // never touches transactional email.
  weeklyOptOut  Boolean   @default(false)

  consentLog          ConsentEvent[]
  children            ChildProfile[]
  subscription        Subscription?
  verificationTokens  VerificationToken[]
  bursaryApplications BursaryApplication[]

  createdAt DateTime  @default(now())
  deletedAt DateTime? // soft delete; hard-delete job runs after 30 days

  @@index([deletedAt])
}

model ChildProfile {
  id        String  @id @default(cuid())
  parentId  String
  parent    ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
  crewName  String // first name or nickname ONLY — no surname field exists
  // ADDENDUM-D §1: the year model. A static year group goes stale every
  // 1 September, so the effective year group is ALWAYS derived —
  // yearGroupAtCapture + (currentAcademicYear − capturedAcademicYear),
  // computed in @cluecrew/core year.ts and never stored denormalised.
  yearGroupAtCapture   Int // Years 3–6 at the moment of capture
  capturedAcademicYear Int // e.g. 2026 = academic year 2026/27
  examYear             Int? // e.g. 2028 — drives programme pacing
  settings  Json // accessibility prefs: reducedMotion, dyslexiaFont, audioDefault
  rank      Rank    @default(TRAINEE)
  // Streak weeks earned (rank input). Forgiveness days are never stored —
  // they are computed transiently and invisible by design (D2).
  streakWeeks Int   @default(0)
  // The single permitted mode pointer (L2 firewall): a UI convenience only.
  // No other mode-choice data may ever be stored — reviewer instruction:
  // reject any PR adding a learner-profile column or score here. See
  // packages/core/src/modes.ts for the full firewall text.
  lastUsedMode String?

  caseFiles       CaseFile[]
  wordVault       WordVaultEntry[]
  attempts        Attempt[]
  sessions        Session[]
  reviewSchedules ReviewSchedule[]
  mockSittings    MockSitting[]
  readinessSnapshots ReadinessSnapshot[]

  createdAt DateTime  @default(now())
  deletedAt DateTime?
}

enum StaffRole {
  NONE
  AUTHOR
  REVIEWER
  ADMIN
}

enum Rank {
  TRAINEE
  JUNIOR_DETECTIVE
  DETECTIVE
  SENIOR_DETECTIVE
  CHIEF_INSPECTOR
}

model ConsentEvent {
  id        String        @id @default(cuid())
  parentId  String
  parent    ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
  kind      String // "tos", "privacy", "child_profile_created", "writing_review_notice", "marketing_optin"
  version   String // policy version consented to
  createdAt DateTime      @default(now())
}

// Email verification (§4: parent verifies email before any child profile exists)
model VerificationToken {
  id        String        @id @default(cuid())
  parentId  String
  parent    ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
  tokenHash String        @unique // sha-256 of the emailed token; raw token never stored
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
}

// ---------- Subscription (§3.2 — schema only; Stripe wiring is Phase 2) ----------

model Subscription {
  id                String        @id @default(cuid())
  parentId          String        @unique
  parent            ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
  tier              Tier
  stripeCustomerId  String?
  stripeSubId       String?
  status            String // trialing | active | past_due | canceled
  // Trial: 7 days, NO card required (BUILD-PHASE-2 §1); card collected at conversion only.
  trialEndsAt       DateTime?
  // Bursary flag — capacity accounting and aggregate reporting ONLY.
  // Grep-level guarantee: no child- or parent-facing UI ever reads this (§6).
  isBursary         Boolean       @default(false)
  firstPaidAt       DateTime? // anchors the 14-day cooling-off window (§2.2)
  canceledAt        DateTime?
  commitmentEndsAt  DateTime? // for DMCC-compliant display of total contract value
  renewalReminderAt DateTime? // next scheduled reminder (T-14 then T-3) (L5)
  // Stripe event ordering guard: webhooks apply only if newer than this.
  lastStripeEventAt DateTime?
  createdAt         DateTime      @default(now())
}

enum Tier {
  TWO_YEAR
  ONE_YEAR
  SUMMER
}

// Processed Stripe webhook ids — makes the handler idempotent under replay (§2).
model WebhookEvent {
  id          String   @id // Stripe event id
  type        String
  processedAt DateTime @default(now())
}

model BursaryApplication {
  id           String        @id @default(cuid())
  parentId     String
  parent       ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
  status       BursaryStatus @default(RECEIVED)
  confirmation String // "fsm" | "pupil_premium" — self-confirmation basis
  // Evidence is AES-256-GCM encrypted at rest and hard-deleted 30 days after decision (§6).
  evidence     Bytes?
  evidenceName String?
  evidenceMime String?
  decidedAt    DateTime?
  decidedById  String?
  evidencePurgeAt DateTime?
  createdAt    DateTime      @default(now())

  @@index([status, createdAt])
}

enum BursaryStatus {
  RECEIVED
  APPROVED
  DECLINED
  WAITLISTED
}

// Audit log on all admin actions (BUILD-PHASE-2 §5).
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String // e.g. "item.publish", "bursary.approve", "region.update"
  targetKind String
  targetId   String
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetKind, targetId])
}

// Region Registry (BUILD-PHASE-2 §3.3): seeded from /content/regions.json,
// maintained via the admin CMS with source URL + last-verified date.
model Region {
  id               String   @id // code slug, e.g. "kent"
  name             String
  examFormat       String // gl-style | csse | set | school-specific | mixed | unknown
  formatSummary    String
  typicalTestMonth String
  subjects         District[]
  exampleSchools   Json
  notes            String?
  sourceUrl        String
  lastVerified     DateTime
  updatedAt        DateTime @updatedAt
}

// ---------- Item bank (§3.3) ----------

model QuestionType {
  id       String   @id // stable slug: "vr-08-move-letter"
  district District
  name     String
  glCode   String? // GL familiarisation numbering where applicable
  mechanic String // slug of the game mechanic that renders it
  items    Item[]
  cases    Case[]
}

enum District {
  VR
  NVR
  MATHS
  ENGLISH
}

model Item {
  id                   String       @id @default(cuid())
  questionTypeId       String
  questionType         QuestionType @relation(fields: [questionTypeId], references: [id])
  difficultyTier       Int // 1–5 authored estimate; live calibration adjusts calibratedDifficulty
  calibratedDifficulty Float? // updated nightly from attempt data
  stem                 Json // structured content, never HTML strings
  options              ItemOption[]
  explanation          Json // per-mode explanation asset refs (watch/walk/see/hear)
  status               ItemStatus   @default(DRAFT) // DRAFT → REVIEWED → LIVE → RETIRED
  // ADDENDUM-B §1: which serving world this item belongs to. MOCK items are
  // new volume on top of the practice gates, never a reclassification of
  // practice items a child may already have met.
  pool                 ItemPool     @default(PRACTICE)
  authoredBy           String // "human:<name>" | "ai-draft:<model>" | "seed" — provenance is mandatory
  reviewedBy           String? // human reviewer name; REQUIRED before LIVE (P3, AI-QC)
  reviewNotes          String? // reviewer feedback when an item is returned to DRAFT
  // Set by the nightly calibration job when calibrated difficulty drifts
  // ≥1.5 tiers from the authored tier — the live QC net (Phase 3 §2).
  calibrationFlaggedAt DateTime?
  // ADDENDUM-E §3: the similarity gate. A flagged item is blocked from
  // REVIEWED until a reviewer clears it with a note — the gate protects
  // against derivation; the reviewer judges coincidence. Score only, never
  // matched text.
  similarityFlaggedAt  DateTime?
  similarityScore      Float?
  similarityClearedBy  String?
  similarityClearNote  String?
  createdAt            DateTime     @default(now())

  @@index([questionTypeId, status, pool])
}

enum ItemStatus {
  DRAFT
  REVIEWED
  LIVE
  RETIRED
}

// ADDENDUM-B §1: mock items are held out from practice, permanently. A mock
// only measures if the child has not seen its questions, so MOCK items are
// never served by the practice/warm-up/review engines — enforced in core item
// selection and again at the query in the orchestrator.
enum ItemPool {
  PRACTICE
  MOCK
}

enum MockSittingStatus {
  SCHEDULED // parent booked it; composition is fixed at this moment
  IN_PROGRESS // the child is sitting it
  COMPLETED // burns every served item for this child (Addendum B §1)
  ABANDONED // kind exit; only the sections the child OPENED burn (§3)
}

model ItemOption {
  id              String         @id @default(cuid())
  itemId          String
  item            Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  content         Json
  isCorrect       Boolean
  misconceptionId String? // REQUIRED on every incorrect option before item goes LIVE (P3)
  misconception   Misconception? @relation(fields: [misconceptionId], references: [id])
}

// ADDENDUM-E §2: corpus-proposed misconceptions land as PROPOSED and are
// unusable by items until a named reviewer approves them. Corpus findings are
// evidence, not instructions — the approval is the door.
enum MisconceptionStatus {
  PROPOSED
  ACTIVE
}

model Misconception {
  id          String       @id // slug: "vr-analogy-surface-match"
  district    District
  description String // teacher-facing
  childHint   String // the authored hint shown when this distractor is chosen
  status      MisconceptionStatus @default(ACTIVE)
  /** "ai-corpus:v1" for corpus-proposed entries (Addendum E §2). */
  proposedBy  String?
  /** Corpus pattern reference — an opaque citation id, never source text. */
  sourcePattern String?
  /** "human:<email>" — set by approval; approval activates. */
  approvedBy  String?
  // Teach-Back content (Phase 3 §6): authored working steps, the index of the
  // step containing the slip, and authored correction options. The engine
  // never generates text (S3) — evaluation is deterministic.
  teachback   Json?
  options     ItemOption[]
}

model Case {
  id              String       @id // slug: "case-vr-08"
  questionTypeId  String
  questionType    QuestionType @relation(fields: [questionTypeId], references: [id])
  title           String // child-facing case name
  narrativeIntro  Json // ≤30s of story (D5)
  modes           Json // asset manifest for the five Modes (P1)
  orderInDistrict Int
  caseFiles       CaseFile[]
}

model CaseFile {
  id           String       @id @default(cuid())
  childId      String
  child        ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  caseId       String
  case         Case         @relation(fields: [caseId], references: [id])
  masteryLevel Float        @default(0) // 0–1; mastery model in /packages/core
  solvedAt     DateTime? // case "cracked"
  taughtBackAt DateTime? // Teach-Back badge (Phase 3 §6)
  lastPracticedAt DateTime? // drives lazy mastery decay (Phase 3 §1)
  // Adaptivity persistence (Phase 3 §2): estimate + rolling outcome window
  // survive across sessions. These are engine state, not analytics.
  tierEstimate Int @default(2)
  recentOutcomes Json @default("[]")
  attemptCount Int @default(0)
  // When the case opened for this child — the new-case pacing signal
  // (Addendum D §2). Backfilled with the migration date for older rows.
  createdAt DateTime @default(now())

  @@unique([childId, caseId])
}

// ---------- Practice, scheduling, vocabulary (§3.4) ----------

model Attempt {
  id             String       @id @default(cuid())
  childId        String
  child          ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  itemId         String
  sessionId      String
  chosenOptionId String?
  correct        Boolean
  latencyMs      Int
  context        String // "case_practice" | "warmup_review" | "boss_case" | "word_vault"
  createdAt      DateTime     @default(now())

  @@index([childId, createdAt])
}

model ReviewSchedule {
  id           String       @id @default(cuid())
  childId      String
  child        ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  unitKind     String // "question_type" | "word"
  unitId       String
  dueAt        DateTime
  intervalDays Float
  easeFactor   Float        @default(2.3)
  lapses       Int          @default(0)

  @@unique([childId, unitKind, unitId])
  @@index([childId, dueAt])
}

model Word {
  id              String           @id // slug of the word
  headword        String
  definitionChild String // authored, reading age ≤9
  sentence        String
  rootFamily      String? // "latin-port", "greek-tele"
  imageRef        String?
  tier            Int // frequency/difficulty tier 1–5
  vaultEntries    WordVaultEntry[]
}

model WordVaultEntry {
  id           String       @id @default(cuid())
  childId      String
  child        ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  wordId       String
  word         Word         @relation(fields: [wordId], references: [id])
  collectedAt  DateTime     @default(now())
  masteryLevel Float        @default(0)

  @@unique([childId, wordId])
}

model Session {
  id            String       @id @default(cuid())
  childId       String
  child         ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  startedAt     DateTime     @default(now())
  endedAt       DateTime?
  secondsActive Int          @default(0) // 15-min cap enforcement (D2) reads this
  // Serialized engine state (packages/core session reducer). The engine is
  // pure; this row is just its persistence.
  engineState Json?
  // Optimistic concurrency for engineState. Every read carries this number and
  // every write requires it to be unchanged, so two overlapping requests can
  // no longer both read the same state, both mutate it, and both save — which
  // silently discarded whichever landed first. The loser is told (409) and the
  // client reloads the real activity. See apps/web/lib/crew/orchestrator.ts.
  stateVersion Int @default(0)
}

// ADDENDUM-B §5: one sat (or scheduled) mock paper. Feeds parent reporting,
// the burn rule, the Stage-2 cohort stats when they arrive, and (aggregated,
// consented) the L1 evidence base. No new personal data: item ids, timings and
// option choices only — same classes of data the practice engine already
// stores per attempt. DPIA note appended (docs/dpia.md).
model MockSitting {
  id          String            @id @default(cuid())
  childId     String
  child       ChildProfile      @relation(fields: [childId], references: [id], onDelete: Cascade)
  blueprintId String // /content/blueprints/<id>.json — content, not a table
  // Per-section composition fixed at scheduling: [{ itemIds: string[] }, …].
  // Which of these burn for the child depends on status + sectionTimings:
  // COMPLETED burns all; ABANDONED burns only sections with a startedAt (§3).
  servedItemIds Json
  // Per section: { startedAt?: ISO, endedAt?: ISO, secondsUsed?: number }.
  sectionTimings Json
  // { [itemId]: { optionId, correct, answeredAt } } — graded server-side; the
  // child's device never receives an isCorrect flag during the sitting.
  responses Json
  status    MockSittingStatus @default(SCHEDULED)
  // Same optimistic-concurrency guard the Session rows carry, same rationale.
  stateVersion Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([childId, blueprintId, status])
  @@index([childId, createdAt])
}

// ADDENDUM-C §5 (+ Addendum D §5): the readiness picture per child, district
// and target blueprint, recomputed nightly and on session end. Feeds the
// parent readiness meter and the L1 evidence base. Percentages of coverage,
// never a judgement of the child; the child never sees any of it (§6).
model ReadinessSnapshot {
  id          String       @id @default(cuid())
  childId     String
  child       ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  district    String // 'VR' | 'MATHS' | …
  blueprintId String
  coveragePct Int // % of blueprint types at "taught and progressing" (≥0.55)
  crackedPct  Int // % of district cases cracked (≥0.8)
  transferPct Int // rolling Boss Round accuracy, last 20 items
  tier        Int // current adaptive tier estimate for context
  // The D §2 matrix column in force when this was computed.
  intensityColumn String
  computedAt      DateTime @default(now())

  @@index([childId, district, computedAt])
}

// ---------- Analytics spine (§6) ----------
// Append-only. Deliberately no foreign keys: rows are removed by the
// hard-delete job, not by cascade, and must never block account deletion.
// Events NEVER contain free text a child wrote, item content, or anything
// beyond IDs and enums (enforced in code via @cluecrew/core assertEvent).

model Event {
  id        String   @id @default(cuid())
  childId   String?
  parentId  String?
  name      String // canonical names live in packages/core/src/events.ts
  props     Json
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([childId, createdAt])
  @@index([parentId, createdAt])
}

// ---------- Retention (§5: design the aggregation now, enable later) ----------
// Anonymised daily rollup written by the aggregation job for attempt data older
// than the child's exam year + 12 months. No childId — aggregate is by design.

model AggregateDailyStat {
  id             String   @id @default(cuid())
  district       District
  questionTypeId String
  day            DateTime @db.Date
  attempts       Int
  correct        Int

  @@unique([district, questionTypeId, day])
}
