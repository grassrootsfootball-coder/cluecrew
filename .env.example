# Copy to .env at the repo root. All packages read the root .env.
# Secrets never go in the repo (BUILD-PHASE-1 §2).

# --- Environment: dev | staging | production
# Staging seeds synthetic data only; never real child data outside production.
APP_ENV=dev

# --- Database (dev: local Postgres; staging/prod: Neon, EU-West region MANDATORY)
DATABASE_URL=postgresql://localhost:5432/cluecrew_dev
SHADOW_DATABASE_URL=postgresql://localhost:5432/cluecrew_shadow

# --- Auth (generate with: openssl rand -base64 32)
AUTH_SECRET=change-me-generate-a-real-secret

# --- Email (Resend; transactional only in Phase 1 — verification + lockout notices).
# Leave RESEND_API_KEY empty in dev: emails are logged to the server console instead.
RESEND_API_KEY=
EMAIL_FROM=ClueCrew <hello@example.test>

# --- Admin allowlist (comma-separated parent-account emails granted /admin)
ADMIN_EMAILS=

# --- Scheduled jobs (hard-delete etc.) authenticate with this when run over HTTP
CRON_SECRET=change-me-too
